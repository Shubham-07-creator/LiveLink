# ==============================================================================
# AETHER - ZERO-COST ENVIRONMENT CONFIGURATION
# All features in this application run at $0.00 cost using free tiers & local models.
# Never expose secrets in client code or version control.
# ==============================================================================

# Application
NEXT_PUBLIC_APP_NAME="Aether"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secure-32-byte-hex-string-for-production"

# LLM Provider Configuration (Zero Cost)
# Primary provider: "gemini" | "groq" | "openrouter" | "ollama"
LLM_PROVIDER="gemini"

# Comma-separated fallback order if primary hits 429 rate limit or errors
FALLBACK_PROVIDERS="groq,openrouter,ollama"

# Models (Never hardcoded in source - adjust as free tier catalogs update)
# Google Gemini (Free Tier: 15 RPM, 1M TPM, 1500 RPD)
GEMINI_API_KEY=""
GEMINI_MODEL_FAST="gemini-1.5-flash"
GEMINI_MODEL_SMART="gemini-1.5-flash"

# Groq (Free Tier: 30 RPM, 6k-20k TPM, 14.4k RPD)
GROQ_API_KEY=""
GROQ_MODEL_FAST="llama-3.1-8b-instant"
GROQ_MODEL_SMART="llama-3.3-70b-versatile"

# OpenRouter (Free models ending in :free)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL_FAST="meta-llama/llama-3.2-3b-instruct:free"
OPENROUTER_MODEL_SMART="google/gemini-2.0-flash-exp:free"

# Ollama (100% Free & Local)
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_MODEL_FAST="llama3.2:latest"
OLLAMA_MODEL_SMART="llama3.2:latest"

# Global Free Tier Model Mapping
MODEL_FAST="gemini-1.5-flash"
MODEL_SMART="gemini-1.5-flash"

# Free Embeddings Configuration
# Options: "local" (via transformers.js all-MiniLM-L6-v2) or "ollama" (nomic-embed-text)
EMBEDDING_PROVIDER="local"
EMBEDDING_MODEL="Xenova/all-MiniLM-L6-v2"
EMBEDDING_DIM="384"

# Database (PostgreSQL with pgvector)
# Free tiers: Supabase, Neon, or local Docker postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aether"

# Rate Limiting & Caching (Zero Cost)
# Upstash Redis Free Tier (10,000 commands/day)
# Leave empty to use high-performance in-memory LRU fallback
REDIS_URL=""
REDIS_TOKEN=""

# Auth Providers (Free OAuth)
# Optional Google OAuth (Leave empty to use Email/Password credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Storage Configuration
# "local" (free local disk in development) or "supabase" (free 1GB bucket)
STORAGE_PROVIDER="local"
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Safety & Global Controls
# Global kill-switch: Set to true to instantly pause all LLM calls if quota spikes
AI_KILL_SWITCH="false"
DAILY_USER_MESSAGE_LIMIT="100"
DAILY_USER_TOKEN_LIMIT="150000"
MAX_UPLOAD_SIZE_MB="5"
